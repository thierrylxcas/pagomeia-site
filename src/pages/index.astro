---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Projects from "../components/Projects.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => post.id !== "o-que-e-o-pagomeia")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);

const videos = [
  { id: "cyNahjqln10", start: 1497 },
  { id: "5ZQFHL8fJtI", start: 416 },
  { id: "aRsNXhXW8O8", start: 2 },
  { id: "EpZS9q39jlw", start: 117 },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="page">
      <section aria-labelledby="editorial-title">
        <h1 id="editorial-title">{SITE_DESCRIPTION}</h1>

        <div class:list={["articles", { "lead-only": posts.length === 1 }]}>
          {posts.map(({ id, data }, index) => (
            <article class:list={["story", {
              lead: index === 0,
              side: index > 0 && index < 4,
            }]}>
              <a href={`/blog/${id}/`}>
                {data.heroImage && (
                  <div class="cover">
                    <img
                      src={data.heroImage}
                      alt=""
                      loading={index < 4 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : undefined}
                      decoding="async"
                    />
                  </div>
                )}
                <div class="story-copy">
                  <span class="category">{data.category}</span>
                  <h2>{data.title}</h2>
                  {index === 0 && <p>{data.description}</p>}
                </div>
              </a>
            </article>
          ))}
        </div>

        <a class="all-articles" href="/blog">
          Ver todos os artigos <span aria-hidden="true">→</span>
        </a>
      </section>

      <section class="videos" aria-labelledby="videos-title">
        <div class="videos-heading">
          <h2 id="videos-title">Assista nossos vídeos</h2>
          <a class="channel" href="https://youtube.com/@pagomeia">
            Visite o canal <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="video-grid">
          {videos.map(({ id, start }, index) => (
            <a
              class="video"
              href={`https://www.youtube.com/watch?v=${id}&t=${start}s`}
              aria-label={`Assistir ao vídeo ${index + 1} do PagoMeia no YouTube`}
            >
              <img
                src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
                alt=""
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
              />
              <span class="play" aria-hidden="true">▶</span>
            </a>
          ))}
        </div>
      </section>

      <Projects />
    </main>
    <Footer />
  </body>
</html>

<style>
  .page {
    width: min(1660px, calc(100% - 64px));
    padding: clamp(18px, 3vh, 32px) 0 0;
  }

  h1 {
  margin-bottom: 20px;
  font-size: clamp(1.5rem, 3vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.06em;
  text-align: center;
}

  .articles {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
  }

  .story {
    grid-column: span 3;
    min-width: 0;
    border: 2px solid var(--brand-ink);
    background: #fff;
  }

  .story a {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .story a:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lead {
    grid-column: span 7;
    grid-row: span 3;
    background: var(--brand-yellow);
    box-shadow: 5px 5px 0 var(--brand-ink);
  }

  .lead-only .lead {
    grid-column: 1 / -1;
    grid-row: auto;
  }

  .side {
    grid-column: span 5;
  }

  .side a {
    display: grid;
    grid-template-columns: 38% minmax(0, 1fr);
    align-items: stretch;
  }

  .side a:not(:has(.cover)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--brand-ink);
    border-bottom: 2px solid var(--brand-ink);
  }

  .lead .cover {
    height: clamp(220px, 40vh, 370px);
    aspect-ratio: auto;
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  .side .cover {
    position: relative;
    aspect-ratio: auto;
    min-height: clamp(96px, 13vh, 132px);
    border-right: 2px solid var(--brand-ink);
    border-bottom: 0;
  }

  .side .cover img {
    position: absolute;
    inset: 0;
  }

  .story-copy {
    align-self: center;
    width: 100%;
    padding: clamp(12px, 1.5vw, 24px);
  }

  .category {
    display: inline-block;
    margin-bottom: 8px;
    padding: 2px 8px;
    background: var(--brand-purple);
    color: var(--brand-cream);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .story:nth-child(2) .category {
    background: var(--brand-pink);
    color: var(--brand-ink);
  }

  .story:nth-child(3) .category {
    background: var(--brand-red);
    color: var(--brand-ink);
  }

  .story h2 {
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.5rem);
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .lead h2 {
    font-size: clamp(1.65rem, 3vw, 2.65rem);
  }

  .lead p {
    margin: 8px 0 0;
  }

  .all-articles,
  .channel {
    padding: 8px 16px;
    font-weight: 800;
    text-decoration: none;
  }

  .all-articles {
    display: table;
    margin: 28px 0 0 auto;
    border: 2px solid var(--brand-ink);
    background: var(--brand-ink);
    color: var(--brand-cream);
  }

  .all-articles:hover {
    background: var(--brand-yellow);
    color: var(--brand-ink);
  }

  .videos {
    margin-top: clamp(36px, 6vw, 72px);
    padding: clamp(16px, 3vw, 36px);
    border: 2px solid var(--brand-ink);
    background: var(--brand-purple);
  }

  .videos-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 20px;
  }

  .videos-heading h2 {
    margin: 0;
    color: var(--brand-cream);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  .channel,
  .play {
    background: var(--brand-yellow);
    color: var(--brand-ink);
  }

  .channel:hover,
  .video:hover .play {
    background: var(--brand-cream);
    color: var(--brand-ink);
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(8px, 1.5vw, 20px);
  }

  .video {
    position: relative;
    display: grid;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    place-items: center;
    border: 2px solid var(--brand-ink);
    background: var(--brand-ink);
  }

  .video img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  .play {
    z-index: 1;
    display: grid;
    width: clamp(32px, 4vw, 54px);
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid var(--brand-ink);
  }

  .video:focus-visible,
  .channel:focus-visible {
    outline: 3px solid var(--brand-cream);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .page {
      width: calc(100% - 36px);
    }

    .articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .story {
      grid-column: span 1;
    }

    .lead,
    .side {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .lead .cover {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .page {
      width: calc(100% - 28px);
    }

    .articles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>