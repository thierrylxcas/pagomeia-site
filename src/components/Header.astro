---
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<div class="container">
		<a href="/" class="brand" aria-label="PagoMeia — início">
			<img src="/images/pagomeia-logo.webp" alt="" width="72" height="72" />
		</a>

		<nav aria-label="Navegação principal">
			<HeaderLink href="/">Início</HeaderLink>
			<HeaderLink href="/blog">Artigos</HeaderLink>
			<a href="/#jogos">Jogos</a>
			<a class="youtube" href="https://youtube.com/@pagomeia" target="_blank" rel="noopener noreferrer">YouTube</a>
		</nav>
	</div>
</header>

<style>
	header {
		background: var(--brand-ink);
		border-bottom: 5px solid var(--brand-purple);
	}

	.container {
		width: min(1240px, calc(100% - 48px));
		min-height: 87px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.brand {
		display: block;
		flex-shrink: 0;
	}

	.brand img {
		display: block;
		object-fit: contain;
		border-radius: 0;
	}

	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 4px;
	}

	nav :global(a) {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 12px;
		color: var(--brand-cream);
		font-size: 0.85rem;
		font-weight: 800;
		text-decoration: none;
	}

	nav :global(a:hover),
	nav :global(a.active) {
		color: var(--brand-yellow);
	}

	nav .youtube {
		background: var(--brand-yellow);
		color: var(--brand-ink);
	}

	nav .youtube:hover {
		color: var(--brand-ink);
		background: var(--brand-pink);
	}

	@media (max-width: 520px) {
		.container {
			width: calc(100% - 24px);
			min-height: 72px;
		}

		.brand img {
			width: 54px;
			height: 54px;
		}

		nav :global(a) {
			padding-inline: 6px;
			font-size: 0.76rem;
		}
	}
</style>