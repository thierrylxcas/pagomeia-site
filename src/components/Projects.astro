---
const base = "https://thierrylxcas.github.io/pagomeia/";
const games = [
  {
    name: "Frames",
    icon: "🎬",
    path: "framed/index.html",
    description: "Adivinhe o filme por uma imagem.",
  },
  {
    name: "MeiaWiki",
    icon: "📚",
    path: "meiaoscar/index.html",
    description: "Ordene os vencedores do Oscar.",
  },
  {
    name: "Tier List",
    icon: "🏆",
    path: "tierlist/index.html",
    description: "Monte seu ranking de filmes e séries.",
  },
  {
    name: "Indicado ou Ignorado",
    icon: "🎭",
    path: "indicado-ignorado/indicado-ignorado.html",
    description: "Descubra se o filme foi indicado.",
  },
];
---

<section class="games" id="jogos" aria-labelledby="games-title">
  <h2 id="games-title">Jogue com a comunidade</h2>

  <div class="grid">
    {games.map(({ name, icon, path, description }) => (
      <a class="card" href={base + path}>
        <span class="icon" aria-hidden="true">{icon}</span>
        <h3>{name}</h3>
        <p>{description}</p>
        <span class="play" aria-hidden="true">Jogar →</span>
      </a>
    ))}
  </div>
</section>

<style>
  .games {
  margin-top: clamp(28px, 5vw, 56px);
  padding: clamp(12px, 3vw, 36px);
  border: 2px solid var(--brand-ink);
  background: #FF4632;
}

  .games h2 {
    margin: 0 0 16px;
    color: var(--brand-cream);
    font-size: clamp(1.25rem, 3vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(8px, 1.5vw, 20px);
  }

  .card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: clamp(9px, 1.6vw, 20px);
    border: 2px solid var(--brand-ink);
    background: var(--brand-yellow);
    color: var(--brand-ink);
    text-decoration: none;
  }

  .card:hover {
    background: var(--brand-cream);
    color: var(--brand-ink);
  }

  .card:focus-visible {
    outline: 3px solid var(--brand-cream);
    outline-offset: 2px;
  }

  .icon {
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1;
  }

  .card h3 {
    margin: 0;
    font-size: clamp(0.9rem, 1.6vw, 1.35rem);
    overflow-wrap: anywhere;
  }

  .card p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .play {
    margin-top: auto;
    font-size: 0.8rem;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .card p {
      font-size: 0.75rem;
    }
  }
</style>